POSTGRES_USER=chainwise
POSTGRES_PASSWORD=change_this_in_prod
POSTGRES_DB=chainwise_db
DATABASE_URL=postgresql+psycopg2://chainwise:change_this_in_prod@postgres:5432/chainwise_db
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
ENVIRONMENT=development
# Values below are development defaults. For production, use docker-compose.production.yml,
# use random secrets (32+ chars, 12+ distinct), HTTPS CORS/API origins, secure cookies, and 5-60 token minutes.
LOG_LEVEL=INFO
SECRET_KEY=change_this_secret_key_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
SLITHER_URL=http://slither:8000
ETHERSCAN_API_KEY=
RISK_MODEL_PATH=/app/ml_models/risk_xgb_model.pkl
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway configuration.
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_MODEL=your-model-name
SENTRY_DSN=
# Для локального запуска можно оставить пустым; подробности — docs/environment.md (Sentry).
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
QUOTA_MAX_CONTRACTS=20
QUOTA_ANALYZE_PER_DAY=20
QUOTA_CHAT_PER_DAY=100
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Same-origin SPA+API (or reverse proxy): Lax + Secure=false on localhost HTTP.
# Cross-site SPA (e.g. :3001 → :8001 without proxy): SameSite=none + Secure=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Browser API base URL; set to the public HTTPS origin for a reverse-proxy deployment.
NEXT_PUBLIC_API_URL=http://localhost:8001
